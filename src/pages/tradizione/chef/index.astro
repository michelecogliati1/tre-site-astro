---
import Layout from "../../../layouts/Layout.astro";

const seoData = {
  title: "Consigli dello Chef: Tecniche e Abbinamenti | Blog TRE",
  description: "Consigli e segreti degli chef: abbinamenti vino e cibo, tecniche di cucina, dietro le quinte della ristorazione. Guida pratica.",
  canonical: "https://www.ristorantepizzeriatre.it/tradizione/chef/",
  ogImage: "https://www.ristorantepizzeriatre.it/img/tradizione/cat-chef-hero.webp",
  preloadImage: "/img/tradizione/cat-chef-hero.webp",
};

const articoli = [
  {
    titolo: "Come Scegliere il Vino Giusto per la Pizza",
    excerpt: "Abbinamento vino e pizza: guida completa per scegliere il vino perfetto. Rosso, bianco o bollicine? Scopri i segreti degli abbinamenti.",
    url: "/tradizione/chef/vino-giusto-per-pizza/",
    immagine: "/img/tradizione/chef/art-vino-pizza-abbinamento.webp",
    data: "2025"
  }
];

const altreCategorie = [
  { titolo: "Ingredienti", url: "/tradizione/ingredienti/", icona: "🫒" },
  { titolo: "Impasti", url: "/tradizione/impasti/", icona: "🍕" },
  { titolo: "Ricette", url: "/tradizione/ricette/", icona: "📖" },
  { titolo: "Territorio", url: "/tradizione/territorio/", icona: "🏔️" }
];

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", "name": "Consigli dello Chef", "description": seoData.description, "url": seoData.canonical },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ristorantepizzeriatre.it/" },
        { "@type": "ListItem", "position": 2, "name": "Tradizione", "item": "https://www.ristorantepizzeriatre.it/tradizione/" },
        { "@type": "ListItem", "position": 3, "name": "Chef", "item": seoData.canonical }
      ]
    }
  ]
};
---

<Layout title={seoData.title} description={seoData.description} canonical={seoData.canonical} ogImage={seoData.ogImage} preloadImage={seoData.preloadImage}>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </Fragment>

  <section class="hero hero-blog-category hero-cat-chef">
    <div class="container hero-content">
      <span class="blog-category-label">La Tradizione</span>
      <h1>Chef: Consigli, Tecniche e Dietro le Quinte</h1>
      <p>Tecniche professionali, abbinamenti vino e cibo, e tutto quello che succede dietro le quinte</p>
    </div>
  </section>

  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/tradizione/">Tradizione</a></li>
        <li aria-current="page">Chef</li>
      </ol>
    </div>
  </nav>

  <section class="blog-intro-section">
    <div class="container">
      <div class="blog-intro">
        <p>Consigli e segreti direttamente dagli chef: tecniche professionali, abbinamenti vino e cibo, organizzazione in cucina e tutto quello che succede dietro le quinte di un ristorante. Scopri anche le nostre <a href="/cene-a-tema/">cene a tema</a> con abbinamenti selezionati.</p>
      </div>
    </div>
  </section>

  <section class="blog-articles-section">
    <div class="container">
      <div class="blog-layout">
        <div class="blog-main">
          <div class="blog-articles-grid">
            {articoli.map((articolo) => (
              <a href={articolo.url} class="blog-article-card">
                <div class="blog-article-image">
                  <img src={articolo.immagine} alt={articolo.titolo} loading="lazy" decoding="async" width="400" height="250" />
                </div>
                <div class="blog-article-content">
                  <h3>{articolo.titolo}</h3>
                  <p>{articolo.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
        <aside class="blog-sidebar">
          <div class="sidebar-block">
            <h4>Altre Categorie</h4>
            <ul class="sidebar-categories">
              {altreCategorie.map((cat) => (
                <li><a href={cat.url}>{cat.icona} {cat.titolo}</a></li>
              ))}
            </ul>
          </div>
          <div class="sidebar-block"><a href="/tradizione/" class="btn btn-outline btn-sidebar">← Torna al Blog</a></div>
          <div class="sidebar-block sidebar-cta">
            <h4>Cene a Tema</h4>
            <p>Scopri le nostre serate con menù degustazione e abbinamenti</p>
            <a href="/cene-a-tema/" class="btn btn-primary btn-sidebar">Cene a Tema</a>
          </div>
          <div class="sidebar-block sidebar-cta">
            <h4>Prenota un Tavolo</h4>
            <a href="/contatti/" class="btn btn-primary btn-sidebar">Prenota Ora</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="blog-newsletter-section blog-newsletter-chef">
    <div class="container">
      <div class="blog-newsletter-content">
        <h2>Ricevi i Consigli dello Chef</h2>
        <p>Iscriviti per scoprire tecniche, abbinamenti e segreti direttamente dalla nostra cucina</p>
        <a href="/cene-a-tema/#newsletter-cene" class="btn btn-primary">Iscriviti alla Newsletter</a>
      </div>
    </div>
  </section>
</Layout>