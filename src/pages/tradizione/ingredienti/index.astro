---
import Layout from "../../../layouts/Layout.astro";

// SEO Data
const seoData = {
  title: "Ingredienti di Qualità nella Cucina Italiana | Blog TRE",
  description: "Scopri l'importanza degli ingredienti di qualità: come riconoscerli, conservarli e utilizzarli. Guida agli ingredienti della cucina italiana.",
  canonical: "https://www.ristorantepizzeriatre.it/tradizione/ingredienti/",
  ogImage: "https://www.ristorantepizzeriatre.it/img/tradizione/cat-ingredienti-hero.webp",
  preloadImage: "/img/tradizione/cat-ingredienti-hero.webp",
};

// Articoli della categoria
const articoli = [
  {
    titolo: "Mozzarella di Bufala DOP: Come Riconoscere la Qualità",
    excerpt: "Guida alla mozzarella di bufala DOP: come riconoscere la qualità, differenze con il fiordilatte, conservazione e abbinamenti perfetti con la pizza.",
    url: "/tradizione/ingredienti/mozzarella-bufala-dop-qualita/",
    immagine: "/img/tradizione/ingredienti/art-mozzarella-bufala-dop.webp",
    data: "2025"
  }
  // Futuri articoli verranno aggiunti qui
];

// Altre categorie
const altreCategorie = [
  { titolo: "Impasti", url: "/tradizione/impasti/", icona: "🍕" },
  { titolo: "Ricette", url: "/tradizione/ricette/", icona: "📖" },
  { titolo: "Territorio", url: "/tradizione/territorio/", icona: "🏔️" },
  { titolo: "Chef", url: "/tradizione/chef/", icona: "👨‍🍳" }
];

// Schema.org
const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Ingredienti di Qualità nella Cucina Italiana",
      "description": seoData.description,
      "url": seoData.canonical
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.ristorantepizzeriatre.it/" },
        { "@type": "ListItem", "position": 2, "name": "Tradizione", "item": "https://www.ristorantepizzeriatre.it/tradizione/" },
        { "@type": "ListItem", "position": 3, "name": "Ingredienti", "item": seoData.canonical }
      ]
    }
  ]
};
---

<Layout 
  title={seoData.title}
  description={seoData.description}
  canonical={seoData.canonical}
  ogImage={seoData.ogImage}
  preloadImage={seoData.preloadImage}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </Fragment>

  <!-- Hero Categoria -->
  <section class="hero hero-blog-category hero-cat-ingredienti">
    <div class="container hero-content">
      <span class="blog-category-label">La Tradizione</span>
      <h1>Ingredienti: La Qualità che Fa la Differenza</h1>
      <p>Come riconoscere, conservare e utilizzare gli ingredienti migliori per la cucina italiana</p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumb">
        <li><a href="/">Home</a></li>
        <li><a href="/tradizione/">Tradizione</a></li>
        <li aria-current="page">Ingredienti</li>
      </ol>
    </div>
  </nav>

  <!-- Intro Categoria -->
  <section class="blog-intro-section">
    <div class="container">
      <div class="blog-intro">
        <p>Esplora il mondo degli ingredienti: dalla scelta della mozzarella di bufala DOP alle farine per pizza, dai pomodori San Marzano all'olio extravergine. Tutto quello che devi sapere per riconoscere e utilizzare ingredienti di qualità nella tua cucina.</p>
      </div>
    </div>
  </section>

  <!-- Articoli + Sidebar -->
  <section class="blog-articles-section">
    <div class="container">
      <div class="blog-layout">
        <div class="blog-main">
          <div class="blog-articles-grid">
            {articoli.map((articolo) => (
              <a href={articolo.url} class="blog-article-card">
                <div class="blog-article-image">
                  <img src={articolo.immagine} alt={articolo.titolo} loading="lazy" decoding="async" width="400" height="250" />
                </div>
                <div class="blog-article-content">
                  <h3>{articolo.titolo}</h3>
                  <p>{articolo.excerpt}</p>
                </div>
              </a>
            ))}
          </div>

          {articoli.length === 0 && (
            <div class="blog-empty">
              <p>Nuovi articoli in arrivo. Iscriviti alla newsletter per restare aggiornato.</p>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="blog-sidebar">
          <div class="sidebar-block">
            <h4>Altre Categorie</h4>
            <ul class="sidebar-categories">
              {altreCategorie.map((cat) => (
                <li><a href={cat.url}>{cat.icona} {cat.titolo}</a></li>
              ))}
            </ul>
          </div>
          <div class="sidebar-block">
            <a href="/tradizione/" class="btn btn-outline btn-sidebar">← Torna al Blog</a>
          </div>
          <div class="sidebar-block sidebar-cta">
            <h4>Scopri il Menù Pizze</h4>
            <p>I nostri ingredienti prendono vita nelle nostre pizze</p>
            <a href="/menu-pizze/" class="btn btn-primary btn-sidebar">Menù Pizze</a>
          </div>
          <div class="sidebar-block sidebar-cta">
            <h4>Prenota un Tavolo</h4>
            <a href="/contatti/" class="btn btn-primary btn-sidebar">Prenota Ora</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA Newsletter -->
  <section class="blog-newsletter-section blog-newsletter-ingredienti">
    <div class="container">
      <div class="blog-newsletter-content">
        <h2>Ricevi i Nuovi Articoli sugli Ingredienti</h2>
        <p>Iscriviti per scoprire guide, curiosità e consigli sulle materie prime della cucina italiana</p>
        <a href="/cene-a-tema/#newsletter-cene" class="btn btn-primary">Iscriviti alla Newsletter</a>
      </div>
    </div>
  </section>

</Layout>